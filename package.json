{
  "name": "Leanote",
  "version": "2.1.4",
  "main": "main.js",
  "bin": {
    "leanote": "./bin/leanote.js"
  },
  "scripts": {
    "dev": "electron .",
    "build": "DEBUG=electron-builder electron-builder",
    "less:build": "node dev/build-less.js",
    "less:watch": "node dev/build-less.js --watch"
  },
  "build": {
    "appId": "site.stanzhai.leanote",
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "async": "^3.2.6",
    "iconv-lite": "^0.7.2",
    "mkdirp": "^3.0.1",
    "nedb": "^1.8.0",
    "needle": "git://github.com/leanote/needle.git",
    "node-getmac": "^1.0.3",
    "validator": "^13.15.26",
    "xml2js": "^0.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "chokidar": "^3.5.3",
    "clean-css": "^5.3.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "glob": "^8.1.0",
    "less": "^4.1.4"
  }
}
